{
  "name": "lightbox",
  "version": "1.2.1",
  "description": "Themeable, localisable image lightbox with a framework-free core and an optional React wrapper",
  "keywords": [
    "lightbox",
    "gallery",
    "astro",
    "react",
    "responsive-images",
    "i18n",
    "vanilla"
  ],
  "license": "MIT",
  "author": "Daniel Hebberd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokyoDanInJapan/lightbox.git"
  },
  "homepage": "https://github.com/TokyoDanInJapan/lightbox#readme",
  "bugs": {
    "url": "https://github.com/TokyoDanInJapan/lightbox/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "predev": "npm --prefix demo install",
    "dev": "npm --prefix demo run dev",
    "prebuild:demo": "npm --prefix demo install",
    "build:demo": "npm --prefix demo run build",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "pretest:e2e": "npm --prefix demo install",
    "test:e2e": "playwright test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
